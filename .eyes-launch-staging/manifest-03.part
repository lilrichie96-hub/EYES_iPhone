"},{"path":"get/media/arcade/tunnelbug.webp","sha":"be2d7fe01ed7dc4f1709a67322b7c35724e6a7f5","base64":""},{"path":"get/media/arcade/prism.webp","sha":"1791e057a6afee692a2d2627288c0fee434f37a0","base64":""},{"path":"get/media/arcade/critter.webp","sha":"2af253200a7fb44df38dd34245d9bc9841ab276c","base64":""},{"path":"get/media/arcade/orbit.webp","sha":"4fb5b7872c4816236a3977f9808fe64819f36199","base64":""},{"path":"get/media/arcade/prism.mp4","sha":"6a8ec0d6f5ed90fc7b2092a83fd3de617f4f2f54","base64":""},{"path":"get/media/arcade/tunnelbug.mp4","sha":"fc484cd5fc15982e03aaf26004c1db3e372a525e","base64":""},{"path":"get/media/arcade/critter.mp4","sha":"7ecaa7b0da94312376498f1a02cce3324b4500d9","base64":""},{"path":"get/index.html","sha":"2a527b758e2b8a33b458243312b0865c4ce6b974","content":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n  <title>EYES \u2014 Your phone. Your creature. Your EYE.</title>\n  <meta name=\"description\" content=\"EYES is a living digital companion that inhabits your phone. Every Eye is one of a kind: it develops its own personality, plays games, meets friends and turns itself into useful tools. Android home screen launcher and iPhone Home Screen app.\">\n  <meta name=\"theme-color\" content=\"#050608\">\n  <meta name=\"color-scheme\" content=\"dark\">\n  <meta property=\"og:type\" content=\"website\">\n  <meta property=\"og:title\" content=\"EYES \u2014 Your phone. Your creature. Your EYE.\">\n  <meta property=\"og:description\" content=\"A living creature for your phone. One of a kind, with its own temperament, an arcade inside its pupil and friends of its own.\">\n  <meta property=\"og:image\" content=\"https://lilrichie96-hub.github.io/EYES_iPhone/get/media/social/og-cover.jpg\">\n  <meta property=\"og:url\" content=\"https://lilrichie96-hub.github.io/EYES_iPhone/get/\">\n  <meta name=\"twitter:card\" content=\"summary_large_image\">\n  <link rel=\"icon\" href=\"favicon.svg\" type=\"image/svg+xml\">\n  <link rel=\"icon\" href=\"favicon-32.png\" sizes=\"32x32\" type=\"image/png\">\n  <link rel=\"apple-touch-icon\" href=\"apple-touch-icon.png\">\n  <link rel=\"preload\" href=\"assets/fonts/InterDisplay-Light.woff\" as=\"font\" type=\"font/woff\" crossorigin>\n  <link rel=\"stylesheet\" href=\"assets/css/site.css\">\n  <script src=\"config.js\" defer></script>\n  <script src=\"assets/js/site.js\" defer></script>\n</head>\n<body>\n<a class=\"skip\" href=\"#main\">Skip to content</a>\n\n<header class=\"nav\" id=\"top\">\n  <a class=\"nav-brand\" href=\"#top\" aria-label=\"EYES home\">\n    <svg class=\"wordmark\" viewBox=\"-1.2 -1.2 62.4 22.4\" role=\"img\" aria-hidden=\"true\"><path d=\"M12 0H0V8.4M0 11.6V20H12\"/><path d=\"M5 10H11.6\"/><path d=\"M16.8 0L22 7.6L27.2 0\"/><path d=\"M22 12.8V20\"/><circle class=\"pupil\" cx=\"22\" cy=\"10.3\" r=\"1.3\"/><path d=\"M44 0H32V20H44\"/><path d=\"M37 10H42.4\"/><path d=\"M57.8 5A3.8 3.8 0 1 0 54 8.8M54 11.2A3.8 3.8 0 1 1 50.2 15\"/></svg>\n  </a>\n  <button class=\"nav-toggle\" aria-expanded=\"false\" aria-controls=\"navlinks\"><span class=\"sr\">Menu</span><span aria-hidden=\"true\"></span></button>\n  <nav id=\"navlinks\" aria-label=\"Sections\">\n    <a href=\"#meet\">Meet your Eye</a>\n    <a href=\"#abilities\">Abilities</a>\n    <a href=\"#arcade\">Arcade</a>\n    <a href=\"#contact\">Eye Contact</a>\n    <a href=\"#home-screen\">Android home</a>\n    <a href=\"#faq\">FAQ</a>\n    <a class=\"nav-cta\" href=\"#install\">Get EYES</a>\n  </nav>\n</header>\n\n<main id=\"main\">\n\n<!-- ============================================================ HERO -->\n<section class=\"hero\" aria-labelledby=\"hero-title\">\n  <div class=\"hero-media\" aria-hidden=\"true\">\n    <video class=\"hero-video\" muted loop playsinline preload=\"none\" poster=\"media/hero/hero-poster.webp\" data-autoplay>\n      <source src=\"media/hero/hero-loop.webm\" type=\"video/webm\">\n      <source src=\"media/hero/hero-loop.mp4\" type=\"video/mp4\">\n    </video>\n  </div>\n  <div class=\"hero-copy\">\n    <p class=\"eyebrow\">A living creature for your phone</p>\n    <h1 id=\"hero-title\">Your phone.<br>Your creature.<br><span>Your EYE.</span></h1>\n    <p class=\"lede\">Somewhere inside your phone, something is waking up. It's yours alone: it has its own look and its own moods, and it will turn itself into whatever you need.</p>\n    <div class=\"hero-actions\">\n      <button class=\"btn btn-play\" data-trailer type=\"button\"><span class=\"play-glyph\" aria-hidden=\"true\"></span>Watch the trailer <small>with sound</small></button>\n    </div>\n    <div class=\"hero-get\">\n      <a class=\"btn btn-primary\" data-apk href=\"#install-android\">Download for Android</a>\n      <a class=\"btn btn-ghost\" data-iphone href=\"#install-iphone\">Open on iPhone</a>\n    </div>\n    <p class=\"fine\" data-apk-note>Android 8 or newer \u00b7 iPhone with Safari \u00b7 Free, no ads, no account</p>\n  </div>\n</section>\n\n<!-- ============================================================ MEET -->\n<section class=\"meet\" id=\"meet\" aria-labelledby=\"meet-title\">\n  <div class=\"wrap\">\n    <p class=\"eyebrow\">Meet your Eye</p>\n    <h2 id=\"meet-title\">No two are alike.</h2>\n    <p class=\"section-lede\">Every Eye hatches from its own seed. Its colour, iris, pupil, rare traits, the way it moves and its temperament are all written in it from the moment it wakes, and nobody else will ever get the same one.</p>\n  </div>\n  <ul class=\"eye-gallery\" role=\"list\">\n    <li><img src=\"media/eyes/eye-kako.webp\" alt=\"Kako, a rose-coloured Eye with fibrous iris\" width=\"420\" height=\"420\" loading=\"lazy\"><b>Kako</b><span>judgy \u00b7 mellow</span></li>\n    <li><img src=\"media/eyes/eye-luni.webp\" alt=\"Luni, an amber Eye with ringed iris\" width=\"420\" height=\"420\" loading=\"lazy\"><b>Luni</b><span>hyper \u00b7 timid</span></li>\n    <li><img src=\"media/eyes/eye-mirmi.webp\" alt=\"Mirmi, a silver Eye with a spiral iris\" width=\"420\" height=\"420\" loading=\"lazy\"><b>Mirmi</b><span>dozy \u00b7 timid</span></li>\n    <li><img src=\"media/eyes/eye-ikoi.webp\" alt=\"Ikoi, a violet Eye with a flower-shaped pupil\" width=\"420\" height=\"420\" loading=\"lazy\"><b>Ikoi</b><span>restless \u00b7 theatrical</span></li>\n    <li><img src=\"media/eyes/eye-wrena.webp\" alt=\"Wrena, a blue Eye with fine radiating fibres\" width=\"420\" height=\"420\" loading=\"lazy\"><b>Wrena</b><span>dramatic \u00b7 sleepy</span></li>\n    <li><img src=\"media/eyes/eye-osis.webp\" alt=\"Osis, a teal Eye scattered with flecks of light\" width=\"420\" height=\"420\" loading=\"lazy\"><b>Osis</b><span>sleepy \u00b7 curious</span></li>\n    <li><img src=\"media/eyes/eye-junoel.webp\" alt=\"Junoel, a green Eye with a starburst iris\" width=\"420\" height=\"420\" loading=\"lazy\"><b>Junoel</b><span>hyper \u00b7 judgy</span></li>\n    <li><img src=\"media/eyes/eye-ikoko.webp\" alt=\"Ikoko, a lime Eye with dashed rings\" width=\"420\" height=\"420\" loading=\"lazy\"><b>Ikoko</b><span>mellow \u00b7 theatrical</span></li>\n  </ul>\n  <div class=\"wrap meet-grid\">\n    <article>\n      <h3>A personality, not a skin</h3>\n      <p>Some Eyes are bashful, some are judgy, some are hopelessly theatrical. Temperament shapes how it glances around, how quickly it gets bored, how it reacts when you poke it and what it likes to do with you.</p>\n    </article>\n    <article>\n      <h3>Alive when you're not looking</h3>\n      <p>It blinks, yawns, stretches, dozes off at night and wakes up curious. It notices the music you play, the weather outside and the charger you plug in.</p>\n    </article>\n    <article>\n      <h3>It remembers how things went</h3>\n      <p>A close game, a good hangout, a battle it lost: a little of that feeling lingers afterwards. Over the weeks it grows from Hatchling to Elder, and the way you treat it nudges how its light matures.</p>\n    </article>\n    <article>\n      <h3>Give it a name</h3>\n      <p>It arrives with a name of its own. Keep it, or give it a nickname of up to 14 characters on its Eye.D. card.</p>\n    </article>\n  </div>\n  <div class=\"wrap promise\" role=\"note\">\n    <p><b>No feeding. No punishment. No streaks.</b> Your Eye never goes hungry, never gets sick because you were busy, and never counts the days you didn't open it. Spend time with it because it's fun.</p>\n  </div>\n</section>\n\n<!-- ============================================================ ABILITIES -->\n<section class=\"abilities\" id=\"abilities\" aria-labelledby=\"abilities-title\">\n  <div class=\"wrap\">\n    <p class=\"eyebrow\">Six abilities</p>\n    <h2 id=\"abilities-title\">It becomes what you need.</h2>\n    <p class=\"section-lede\">Tap the small satellite beside your Eye and six abilities unfold. Tap one and the Eye physically reshapes itself into it. Not sure? Hold an ability for a moment and the Eye shows you a little preview first.</p>\n  </div>\n  <div class=\"wrap ability-list\">\n    <article class=\"ability\" data-tone=\"vision\">\n      <div class=\"ability-media\"><video muted loop playsinline preload=\"none\" poster=\"media/abilities/vision.webp\" data-autoplay aria-label=\"Vision reading a QR code on a card\"><source src=\"media/abilities/vision.mp4\" type=\"video/mp4\"></video></div>\n      <div class=\"ability-copy\">\n        <h3><span class=\"num\">01</span> Vision</h3>\n        <p>The pupil opens into a camera lens. Point it at a QR code and your Eye reads it, then lets you open the link, copy it or scan again. It can also take a photo.</p>\n        <p class=\"tag\">Uses the camera only while Vision is open</p>\n      </div>\n    </article>\n    <article class=\"ability\" data-tone=\"weather\">\n      <div class=\"ability-media\"><video muted loop playsinline preload=\"none\" poster=\"media/abilities/weather.webp\" data-autoplay aria-label=\"Weather Organ showing a rainy sky inside the Eye\"><source src=\"media/abilities/weather.mp4\" type=\"video/mp4\"></video></div>\n      <div class=\"ability-copy\">\n        <h3><span class=\"num\">02</span> Weather Organ</h3>\n        <p>Your Eye becomes a tiny living sky made from the real forecast for the place you choose: rain, snow, fog, sun or stars. Drag around the dial to look ahead through the next hours, or switch to 7 days.</p>\n        <p class=\"tag\">Pick a city or postal code \u00b7 forecast by Open-Meteo</p>\n      </div>\n    </article>\n    <article class=\"ability\" data-tone=\"pocket\">\n      <div class=\"ability-media\"><video muted loop playsinline preload=\"none\" poster=\"media/abilities/pocket.webp\" data-autoplay aria-label=\"Pocket Dimension swallowing a note\"><source src=\"media/abilities/pocket.mp4\" type=\"video/mp4\"></video></div>\n      <div class=\"ability-copy\">\n        <h3><span class=\"num\">03</span> Pocket Dimension</h3>\n        <p>Hand it a thought, a link, a picture or a file and it swallows it into its pupil, then gives it back whenever you ask. On Android you can also share things to EYES from other apps.</p>\n        <p class=\"tag\">Kept only on your phone \u00b7 handy storage, not a vault</p>\n      </div>\n    </article>\n    <article class=\"ability\" data-tone=\"arcade\">\n      <div class=\"ability-media\"><video muted loop playsinline preload=\"none\" poster=\"media/abilities/arcade.webp\" data-autoplay aria-label=\"The Eye Arcade shelf with four games\"><source src=\"media/abilities/arcade.mp4\" type=\"video/mp4\"></video></div>\n      <div class=\"ability-copy\">\n        <h3><span class=\"num\">04</span> Arcade</h3>\n        <p>The Eye flips into a little game console with four games inside. Your Eye watches, cheers and sulks along with you.</p>\n        <p class=\"tag\"><a href=\"#arcade\">See the four games \u2193</a></p>\n      </div>\n    </article>\n    <article class=\"ability\" data-tone=\"contact\">\n      <div class=\"ability-media\"><video muted loop playsinline preload=\"none\" poster=\"media/abilities/contact.webp\" data-autoplay aria-label=\"Two Eyes exchanging a pulse in Eye Contact\"><source src=\"media/abilities/contact.mp4\" type=\"video/mp4\"></video></div>\n      <div class=\"ability-copy\">\n        <h3><span class=\"num\">05</span> Eye Contact</h3>\n        <p>Link your Eye with people you know. Their Eye appears in your Meeting Space, and the two of you can send signals, hang out and battle from anywhere.</p>\n        <p class=\"tag\"><a href=\"#contact\">More about Eye Contact \u2193</a></p>\n      </div>\n    </article>\n    <article class=\"ability\" data-tone=\"play\">\n      <div class=\"ability-media\"><video muted loop playsinline preload=\"none\" poster=\"media/abilities/play.webp\" data-autoplay aria-label=\"Play: the Eye chasing a firefly\"><source src=\"media/abilities/play.mp4\" type=\"video/mp4\"></video></div>\n      <div class=\"ability-copy\">\n        <h3><span class=\"num\">06</span> Play</h3>\n        <p>Arcade is where you play games. Play is where you play with your Eye: a staring contest, a firefly to chase, a ball to catch, peekaboo, or simply some quiet company. Or let it surprise you.</p>\n        <p class=\"tag\">No points, no rewards. The fun is the point.</p>\n      </div>\n    </article>\n  </div>\n</section>\n\n<!-- ============================================================ ARCADE -->\n<section class=\"arcade\" id=\"arcade\" aria-labelledby=\"arcade-title\">\n  <div class=\"wrap\">\n    <p class=\"eyebrow\">Eye Arcade</p>\n    <h2 id=\"arcade-title\">A whole arcade inside your Eye.</h2>\n    <p class=\"section-lede\">Four original games live inside the Eye itself. They're part of EYES, so once EYES is installed they play offline: on a plane, on the subway, wherever.</p>\n  </div>\n  <div class=\"wrap carts\">\n    <article class=\"cart\" data-game=\"tunnelbug\">\n      <div class=\"cart-screen\"><video muted loop playsinline preload=\"none\" poster=\"media/arcade/tunnelbug.webp\" data-autoplay aria-label=\"Tunnelbug gameplay\"><source src=\"media/arcade/tunnelbug.mp4\" type=\"video/mp4\"></video></div>\n      <h3>Tunnelbug</h3>\n      <p>Dig for energy. Dodge what lives down there. Play a 90-second Timed run, or go Endless and see how deep you can get.</p>\n    </article>\n    <article class=\"cart\" data-game=\"orbit\">\n      <div class=\"cart-screen\"><video muted loop playsinline preload=\"none\" poster=\"media/arcade/orbit.webp\" data-autoplay aria-label=\"Orbit Breaker gameplay\"><source src=\"media/arcade/orbit.mp4\" type=\"video/mp4\"></video></div>\n      <h3>Orbit Breaker</h3>\n      <p>Drift through crystal debris. Break it before it breaks you.</p>\n    </article>\n    <article class=\"cart\" data-game=\"critter\">\n      <div class=\"cart-screen\"><video muted loop playsinline preload=\"none\" poster=\"media/arcade/critter.webp\" data-autoplay aria-label=\"Critter Crossing gameplay\"><source src=\"media/arcade/critter.mp4\" type=\"video/mp4\"></video></div>\n      <h3>Critter Crossing</h3>\n      <p>Hop a tiny critter over lanes, rafts and streams.</p>\n    </article>\n    <article class=\"cart\" data-game=\"prism\">\n      <div class=\"cart-screen\"><video muted loop playsinline preload=\"none\" poster=\"media/arcade/prism.webp\" data-autoplay aria-label=\"Prism Break gameplay\"><source src=\"media/arcade/prism.mp4\" type=\"video/mp4\"></video></div>\n      <h3>Prism Break</h3>\n      <p>Shatter formations of luminous crystal.</p>\n    </article>\n  </div>\n</section>\n\n<!-- ============================================================ EYE CONTACT -->\n<section class=\"contact\" id=\"contact\" aria-labelledby=\"contact-title\">\n  <div class=\"wrap\">\n    <p class=\"eyebrow\">Eye Contact</p>\n    <h2 id=\"contact-title\">You are not alone.</h2>\n    <p class=\"section-lede\">Invite someone you know with a link or a code. From then on your Eyes know each other, on Android and iPhone alike. There's no chat and no feed: just two creatures who keep finding each other.</p>\n  </div>\n  <div class=\"wrap contact-grid\">\n    <figure class=\"contact-hero\">\n      <img src=\"media/contact/meet.webp\" alt=\"The Meeting Space: two Eyes, Kako and Ikoi, linked by a thread of light, with Pulse, Spark and Calm buttons\" width=\"824\" height=\"1830\" loading=\"lazy\">\n    </figure>\n    <div class=\"contact-points\">\n      <article><h3>Pulse &amp; Spark</h3><p>Send a warm Pulse, a bright Spark or a slow Calm. Their Eye feels it on the other phone. Answer a Pulse within about half a minute while you're both in EYES, and your Eyes resonate.</p></article>\n      <article><h3>Hangouts</h3><p>Invite their Eye over. The two of them play catch, chase fireflies and goof around on their own while you watch, or join in with a tap.</p></article>\n      <article><h3>Battles</h3><p>An Eye Duel is a quick contest of looks: glare, blink, charge. Each Eye fights in its own temperament.</p></article>\n      <article><h3>Shared history</h3><p>Each friendship remembers when you met, battles fought together, Hangouts shared and the last time you were together. It's kept only on your phone.</p></article>\n    </div>\n  </div>\n  <div class=\"wrap contact-strip\">\n    <figure><img src=\"media/contact/hangout.webp\" alt=\"A Hangout: Kako and Ikoi playing together\" width=\"824\" height=\"1830\" loading=\"lazy\"><figcaption>Hangout</figcaption></figure>\n    <figure><img src=\"media/contact/duel.webp\" alt=\"An Eye Duel in round four\" width=\"824\" height=\"1830\" loading=\"lazy\"><figcaption>Eye Duel</figcaption></figure>\n    <figure><img src=\"media/contact/history.webp\" alt=\"Shared history with a friend\" width=\"824\" height=\"1830\" loading=\"lazy\"><figcaption>Shared history</figcaption></figure>\n    <figure data-feature=\"exchange\"><img src=\"media/contact/exchange.webp\" alt=\"Trade Eyes: offering an Eye Exchange to a friend\" width=\"824\" height=\"1830\" loading=\"lazy\"><figcaption>Eye Exchange <span class=\"badge\" data-testing-badge>Testing</span></figcaption></figure>\n  </div>\n  <div class=\"wrap exchange-note\" data-feature=\"exchange\">\n    <h3>Eye Exchange <span class=\"badge\" data-testing-badge>Testing</span></h3>\n    <p>Two friends can agree to trade Eyes, one for one. Both see both Eyes first, both have to confirm, and the trade is permanent: each Eye goes to live with its new person, carrying its name, looks, personality and a journal of the homes it has lived in. It's always optional and nothing happens until you both confirm.</p>\n    <p class=\"fine\" data-testing-only>Eye Exchange is still being tested on real phones. Only trade with people you know, and consider trying it first with an Eye you've made a Passport for.</p>\n  </div>\n</section>\n\n<!-- ============================================================ ANDROID HOME -->\n<section class=\"homescreen\" id=\"home-screen\" aria-labelledby=\"home-title\">\n  <div class=\"wrap\">\n    <p class=\"eyebrow\">Make your phone its home</p>\n    <h2 id=\"home-title\">On Android, EYES is your home screen.</h2>\n    <p class=\"section-lede\">Choose EYES as your Home app and the Eye lives where your wallpaper used to be: a complete launcher, built around a creature.</p>\n  </div>\n  <div class=\"wrap home-grid\">\n    <figure class=\"phone-shot\"><img src=\"media/home/home.webp\" alt=\"The EYES home screen with the clock, weather, the Eye and a dock of apps\" width=\"824\" height=\"1830\" loading=\"lazy\"></figure>\n    <ul class=\"feature-list\" role=\"list\">\n      <li><b>App drawer</b><span>Every app, searchable, one swipe away.</span></li>\n      <li><b>Dock</b><span>Up to five favourites at the bottom.</span></li>\n      <li><b>Iris shortcuts</b><span>Keep your most-used apps a touch away from the Eye.</span></li>\n      <li><b>Your layout</b><span>Arrange apps on the home screen, pick a style, and choose how much the Eye moves.</span></li>\n      <li><b>Folders</b><span>Folders unfold around the Eye like a little constellation.</span></li>\n      <li><b>Music</b><span>When something plays, the iris becomes the player. Swipe to skip; the volume keys can flow through the Eye.</span></li>\n      <li><b>Notifications</b><span>A glint appears in the iris. Hold it to peek, or tap the Eye to see your notifications and the day ahead.</span></li>\n      <li><b>Charging</b><span>Plug in and a quiet heartbeat lives inside the iris.</span></li>\n    </ul>\n  </div>\n  <div class=\"wrap home-strip\">\n    <figure><img src=\"media/home/drawer.webp\" alt=\"The app drawer\" width=\"824\" height=\"1830\" loading=\"lazy\"><figcaption>App drawer</figcaption></figure>\n    <figure><img src=\"media/home/folder.webp\" alt=\"A folder unfolding around the Eye\" width=\"824\" height=\"1830\" loading=\"lazy\"><figcaption>Folders</figcaption></figure>\n    <figure><img src=\"media/home/music.webp\" alt=\"Music playing through the iris\" width=\"824\" height=\"1830\" loading=\"lazy\"><figcaption>Music</figcaption></figure>\n    <figure><img src=\"media/home/charging.webp\" alt=\"The charging heartbeat\" width=\"824\" height=\"1830\" loading=\"lazy\"><figcaption>Charging</figcaption></figure>\n  </div>\n  <div class=\"wrap\">\n    <div class=\"compare\" role=\"region\" aria-label=\"Android and iPhone compared\" tabindex=\"0\">\n      <table>\n        <caption>What you get on each phone</caption>\n        <thead><tr><th scope=\"col\"></th><th scope=\"col\">Android</th><th scope=\"col\">iPhone</th></tr></thead>\n        <tbody>\n          <tr><th scope=\"row\">Your own living Eye, Eye.D. card, nickname</th><td>\u2713</td><td>\u2713</td></tr>\n          <tr><th scope=\"row\">All six abilities, including the four Arcade games</th><td>\u2713</td><td>\u2713</td></tr>\n          <tr><th scope=\"row\">Eye Contact, Hangouts, battles, shared history</th><td>\u2713</td><td>\u2713</td></tr>\n          <tr><th scope=\"row\">Eye Passport backup</th><td>\u2713</td><td>\u2713</td></tr>\n          <tr><th scope=\"row\">Home screen launcher: app drawer, dock, folders, iris shortcuts</th><td>\u2713</td><td>\u2014</td></tr>\n          <tr><th scope=\"row\">Music in the iris, notification glints, Volume Iris</th><td>\u2713</td><td>\u2014</td></tr>\n          <tr><th scope=\"row\">Charging heartbeat (needs the battery level)</th><td>\u2713</td><td>\u2014</td></tr>\n          <tr><th scope=\"row\">Share to EYES from other apps</th><td>\u2713</td><td>\u2014</td></tr>\n          <tr><th scope=\"row\">How you open it</th><td>Your home screen</td><td>An icon on your Home Screen</td></tr>\n        </tbody>\n      </table>\n    </div>\n  </div>\n</section>\n\n<!-- ============================================================ INSTALL -->\n<section class=\"install\" id=\"install\" aria-labelledby=\"install-title\">\n  <div class=\"wrap\">\n    <p class=\"eyebrow\">Get EYES</p>\n    <h2 id=\"install-title\">Wake yours up.</h2>\n    <p class=\"section-lede\">Free. No account, no ads, no app store needed.</p>\n  </div>\n  <div class=\"wrap install-grid\">\n    <article class=\"install-card\" id=\"install-android\">\n      <h3>Android</h3>\n      <ol class=\"steps\">\n        <li><b>Download the APK.</b> <span>Tap the button below on your Android phone.</span></li>\n        <li><b>Allow installation when asked.</b> <span>Android asks once whether your browser may install apps. Tap Settings, allow it, then go back.</span></li>\n        <li><b>Install EYES.</b> <span>Open the downloaded file and tap Install.</span></li>\n        <li><b>Optional: make EYES your Home app.</b> <span>Open EYES, then The Optic (the round icon at the top) \u2192 Make EYES home. Or later, in Android Settings \u2192 Apps \u2192 Default apps \u2192 Home app.</span></li>\n      </ol>\n      <a class=\"btn btn-primary btn-wide\" data-apk href=\"#install-android\">Download for Android</a>\n      <p class=\"fine\" data-apk-meta></p>\n      <p class=\"callout\"><b>Already have EYES?</b> Install the new version right over the old one. Don't uninstall first \u2014 uninstalling erases your Eye unless you've saved an Eye Passport.</p>\n    </article>\n    <article class=\"install-card\" id=\"install-iphone\">\n      <h3>iPhone</h3>\n      <ol class=\"steps\">\n        <li><b>Open EYES in Safari.</b> <span>Tap the button below on your iPhone.</span></li>\n        <li><b>Tap the Share button.</b> <span>The square with an arrow, at the bottom of Safari.</span></li>\n        <li><b>Choose Add to Home Screen.</b> <span>Scroll down the menu if you don't see it, then tap Add.</span></li>\n        <li><b>Open EYES from its new icon.</b> <span>Your Eye wakes up the first time you open it there.</span></li>\n      </ol>\n      <a class=\"btn btn-ghost btn-wide\" data-iphone href=\"#install-iphone\">Open EYES on iPhone</a>\n      <p class=\"callout\"><b>Already have EYES?</b> Just open it while you're online; it updates itself. Close it and open it once more to finish. Please don't delete the Home Screen icon to update \u2014 that can erase your Eye.</p>\n    </article>\n  </div>\n</section>\n\n<!-- ============================================================ PASSPORT / PRIVACY / FAQ -->\n<section class=\"faq\" id=\"faq\" aria-labelledby=\"faq-title\">\n  <div class=\"wrap faq-top\">\n    <div>\n      <p class=\"eyebrow\">Keep it safe</p>\n      <h2 id=\"faq-title\">Eye Passport, privacy &amp; questions</h2>\n    </div>\n    <figure class=\"passport-shot\"><img src=\"media/card/eyed.webp\" alt=\"An Eye.D. card: name, temperament, rarity, iris, pupil and stage\" width=\"824\" height=\"1830\" loading=\"lazy\"></figure>\n  </div>\n  <div class=\"wrap faq-list\">\n    <details open>\n      <summary>How do I back up my Eye?</summary>\n      <p>Make an <b>Eye Passport</b>: open EYES \u2192 The Optic \u2192 Eye Passport \u2192 Create, and choose a passphrase. The passport is a single block of text, encrypted with that passphrase, that carries your Eye, its growth and personality, your friendships, your Eye Dex, Arcade bests and settings. Keep it somewhere safe (a note, an email to yourself) and write the passphrase down: nobody can open the passport without it, not even FRAY. To bring your Eye back on a new phone, choose Restore in the same place.</p>\n      <p>Because it holds your friendships' secrets, keep your passport to yourself.</p>\n    </details>\n    <details>\n      <summary>How do I protect important Pocket Dimension files?</summary>\n      <p>The Pocket Dimension is handy local storage, not a backup or a vault. Items are kept only on your phone, they aren't encrypted, and they are <b>not</b> included in an Eye Passport. Uninstalling EYES or clearing its data erases them. If something matters, open it in the pocket and share or save a copy somewhere else too.</p>\n    </details>\n    <details>\n      <summary>What stays on my phone?</summary>\n      <p>Your Eye itself, the Pocket Dimension, Arcade scores, shared history with friends, your nickname (outside an Eye Exchange) and your settings all stay on your phone. EYES has no account, no ads and no analytics.</p>\n    </details>\n    <details>\n      <summary>What needs an internet connection?</summary>\n      <ul>\n        <li><b>Eye Contact</b> (signals, Hangouts, battles) goes through a Firebase database with an anonymous sign-in. The messages between two Eyes are end-to-end encrypted, so the database only relays scrambled text.</li>\n        <li data-feature=\"exchange\"><b>Eye Exchange</b> stores what a trade needs in that same database: the Eye being traded (its looks and personality data), the labels you chose, its journal of homes, anonymous IDs and a recovery key. These records are not end-to-end encrypted, so the project owner can read them.</li>\n        <li><b>Weather</b> sends only the place you choose (or, if you allow it, rounded coordinates) to Open-Meteo to get the forecast.</li>\n        <li><b>iPhone notifications</b>, if you turn them on, register your push subscription with the EYES push relay.</li>\n        <li><b>Installing and updating</b> EYES downloads it from GitHub, which keeps ordinary web server logs.</li>\n      </ul>\n      <p>Everything else, including the Eye, Play, Vision, the Pocket Dimension and all four Arcade games, works offline once EYES is installed.</p>\n    </details>\n    <details>\n      <summary>Which permissions does EYES ask for, and why?</summary>\n      <p>All of them are optional; EYES keeps working if you say no.</p>\n      <ul>\n        <li><b>Camera</b> \u2014 only for Vision, while Vision is open.</li>\n        <li><b>Notification access</b> (Android) \u2014 so notification glints and music controls can appear in the Eye. Choose it in The Optic \u2192 Notifications &amp; music access.</li>\n        <li><b>Screen and audio capture</b> (Android, Live Audio) \u2014 only if you turn on Live Audio, so the iris can react to the actual sound of what's playing. It's analysed on the phone.</li>\n        <li><b>Default Home app</b> (Android) \u2014 only if you want EYES as your launcher.</li>\n        <li><b>Location</b> (iPhone, optional) \u2014 only if you ask Weather to use where you are instead of typing a city.</li>\n        <li><b>Notifications</b> (iPhone, optional) \u2014 to hear from friends' Eyes when EYES is closed.</li>\n      </ul>\n    </details>\n    <details>\n      <summary>What's different between Android and iPhone?</summary>\n      <p>The Eye, its abilities, the Arcade, Eye Contact and Eye Passport are on both, and Android and iPhone Eyes can be friends with each other. Only Android can be a full home screen launcher, so the app drawer, dock, folders, iris shortcuts, music and notification glints, Volume Iris, the charging heartbeat and sharing into the Pocket Dimension from other apps are Android only. On iPhone, EYES opens from an icon on your Home Screen.</p>\n    </details>\n    <details>\n      <summary>How do I go back to my old Android launcher?</summary>\n      <p>Open Android <b>Settings \u2192 Apps \u2192 Default apps \u2192 Home app</b> and pick your previous launcher. (On some phones it's under Settings \u2192 Apps \u2192 Choose default apps.) EYES stays installed and your Eye keeps waiting; you can switch back any time.</p>\n    </details>\n    <details>\n      <summary>Is my Eye ever reset or replaced?</summary>\n      <p>No. There are no rerolls and no paid ones: the Eye you wake up is yours. Updates keep your Eye as long as you install them over your current version (Android) or simply reopen EYES online (iPhone).</p>\n    </details>\n    <details>\n      <summary>Does it cost anything?</summary>\n      <p>No. EYES is free, with no ads, no subscriptions and no in-app purchases.</p>\n    </details>\n  </div>\n</section>\n\n</main>\n\n<footer class=\"foot\">\n  <div class=\"wrap foot-grid\">\n    <div>\n      <svg class=\"wordmark\" viewBox=\"-1.2 -1.2 62.4 22.4\" role=\"img\" aria-label=\"EYES\"><path d=\"M12 0H0V8.4M0 11.6V20H12\"/><path d=\"M5 10H11.6\"/><path d=\"M16.8 0L22 7.6L27.2 0\"/><path d=\"M22 12.8V20\"/><circle class=\"pupil\" cx=\"22\" cy=\"10.3\" r=\"1.3\"/><path d=\"M44 0H32V20H44\"/><path d=\"M37 10H42.4\"/><path d=\"M57.8 5A3.8 3.8 0 1 0 54 8.8M54 11.2A3.8 3.8 0 1 1 50.2 15\"/></svg>\n      <p class=\"fine\">EYES by FRAY, INC. \u00b7 Weird. Understated. Alive.</p>\n    </div>\n    <nav aria-label=\"Footer\">\n      <a href=\"privacy.html\">Privacy</a>\n      <a href=\"attribution.html\">Credits &amp; licences</a>\n      <a data-support hidden href=\"#\">Report a problem</a>\n    </nav>\n  </div>\n  <p class=\"wrap fine media-note\">All app imagery on this page is captured from the real EYES 5.0 app. Device frames and backgrounds are presentation only.</p>\n</footer>\n\n<!-- trailer player: loads only when asked, plays with sound -->\n<dialog class=\"trailer\" id=\"trailer\" aria-label=\"EYES trailer\">\n  <div class=\"trailer-inner\">\n    <button class=\"trailer-close\" type=\"button\" data-close aria-label=\"Close trailer\">\u00d7</button>\n    <video id=\"trailerVideo\" controls playsinline preload=\"none\" poster=\"media/trailer/trailer-poster.webp\">\n      <track kind=\"captions\" src=\"media/trailer/eyes-trailer-captions.vtt\" srclang=\"en\" label=\"English\">\n    </video>\n  </div>\n</dialog>\n</body>\n</html>\n"},{"path":"get/attribution.html","sha":"2eedd161bce1875db45120da836e85a8649fa655","content":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n  <title>Credits &amp; licences \u00b7 EYES</title>\n  <meta name=\"theme-color\" content=\"#050608\">\n  <link rel=\"icon\" href=\"favicon.svg\" type=\"image/svg+xml\">\n  <link rel=\"stylesheet\" href=\"assets/css/site.css\">\n  <link rel=\"stylesheet\" href=\"assets/css/page.css\">\n  <script src=\"config.js\" defer></script>\n  <script src=\"assets/js/page.js\" defer></script>\n</head>\n<body class=\"page\">\n<a class=\"skip\" href=\"#main\">Skip to content</a>\n<header class=\"page-head wrap\"><a href=\"./\" class=\"back\" aria-label=\"Back to the EYES home page\">\u2190 EYES</a></header>\n<main id=\"main\" class=\"wrap prose\">\n  <p class=\"eyebrow\">Credits</p>\n  <h1>Credits &amp; licences</h1>\n\n  <h2>EYES</h2>\n  <p>EYES is made by FRAY, INC. The creatures, games, sounds and art in the app are original: they're drawn and generated by the app's own code. EYES bundles no third-party code libraries.</p>\n\n  <h2>Services</h2>\n  <ul>\n    <li><b>Weather data</b> by <a href=\"https://open-meteo.com/\">Open-Meteo.com</a>, licensed under <a href=\"https://creativecommons.org/licenses/by/4.0/\">CC BY 4.0</a>.</li>\n    <li><b>Eye Contact</b> messages are relayed through Firebase Realtime Database (Google).</li>\n    <li>The app and this website are hosted on GitHub Pages.</li>\n  </ul>\n\n  <h2>This website</h2>\n  <ul>\n    <li>Typeface: <b>Inter Display</b> by The Inter Project Authors, used under the <a href=\"assets/fonts/OFL.txt\">SIL Open Font License 1.1</a>.</li>\n    <li>All app imagery and gameplay is captured from the EYES 5.0 app itself. Device frames, backgrounds and titles are presentation.</li>\n    <li>The trailer's music and sound effects are original, synthesized for EYES, and owned by FRAY, INC.</li>\n  </ul>\n</main>\n<footer class=\"foot\"><div class=\"wrap foot-grid\"><p class=\"fine\">EYES by FRAY, INC.</p><nav aria-label=\"Footer\"><a href=\"./\">Home</a><a href=\"privacy.html\">Privacy</a></nav></div></footer>\n</body>\n</html>\n"},{"path":"get/privacy.html","sha":"c1f73a67072a76397f2db98efd3210d66290da6b","content":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n  <title>Privacy \u00b7 EYES</title>\n  <meta name=\"description\" content=\"What EYES keeps on your phone, what it sends, and why.\">\n  <meta name=\"theme-color\" content=\"#050608\">\n  <link rel=\"icon\" href=\"favicon.svg\" type=\"image/svg+xml\">\n  <link rel=\"stylesheet\" href=\"assets/css/site.css\">\n  <link rel=\"stylesheet\" href=\"assets/css/page.css\">\n  <script src=\"config.js\" defer></script>\n  <script src=\"assets/js/page.js\" defer></script>\n</head>\n<body class=\"page\">\n<a class=\"skip\" href=\"#main\">Skip to content</a>\n<header class=\"page-head wrap\"><a href=\"./\" class=\"back\" aria-label=\"Back to the EYES home page\">\u2190 EYES</a></header>\n<main id=\"main\" class=\"wrap prose\">\n  <p class=\"eyebrow\">Privacy</p>\n  <h1>What EYES keeps, and what it sends</h1>\n  <p class=\"fine\">Applies to EYES 5.0 for Android and EYES 3.0 for iPhone, and to this website. Last reviewed for the 5.0 release.</p>\n\n  <h2>The short version</h2>\n  <ul>\n    <li>No account, no ads, no analytics, no tracking. EYES does not sell your personal data. The online services it uses are described below.</li>\n    <li>Your Eye, the Pocket Dimension, Arcade scores, shared history and your settings are kept on your phone.</li>\n    <li>A few features need the internet to work. They're listed below, with exactly what they send.</li>\n  </ul>\n\n  <h2>Kept on your phone</h2>\n  <p>Your Eye (its looks, personality, growth and nickname), its habits and moods, the Pocket Dimension, Arcade best scores, Play, your Eye Dex, shared history with friends, your launcher layout and your settings. These are stored in the app's own storage on the phone. Uninstalling EYES (Android), deleting the Home Screen app (iPhone) or clearing its data erases them, unless you've saved an Eye Passport.</p>\n  <p><b>The Pocket Dimension</b> is handy local storage, not a vault: its items aren't encrypted, nothing in it is uploaded, and it isn't included in an Eye Passport. EYES never reads your clipboard, photos or files unless you hand them over.</p>\n\n  <h2>Sent over the internet, and only when you use these features</h2>\n  <h3>Eye Contact (friends, signals, Hangouts, battles)</h3>\n  <p>EYES uses a Firebase Realtime Database (a Google service) with an anonymous sign-in, so each phone gets a random ID instead of an account. Messages between two linked Eyes are end-to-end encrypted with a key only those two phones share, so the database relays scrambled text it can't read.</p>\n  <h3 data-feature=\"exchange\">Eye Exchange <span class=\"badge\" data-testing-badge>Testing</span></h3>\n  <p data-feature=\"exchange\">When two friends trade Eyes, the trade is coordinated through the same database. It stores, without end-to-end encryption: the Eye being traded (its looks and personality data), the exchange labels you chose, its journal of homes, the anonymous IDs involved, and a recovery key. The database rules are designed to prevent other users from reading the recovery key, but the EYES project owner can read these records.</p>\n  <h3>Weather Organ</h3>\n  <p>The forecast comes from <a href=\"https://open-meteo.com/\">Open-Meteo</a>. EYES sends the city or postal code you type to look it up, and then the coordinates of the place you picked to get its forecast. On iPhone you can instead allow your location; it's rounded to about 1 km first. Turning Weather off stops these requests.</p>\n  <h3>iPhone notifications (optional)</h3>\n  <p>If you turn on notifications on iPhone, your browser's push subscription and your friendship mailbox IDs are registered with the EYES push relay, so a friend's signal can reach you while EYES is closed. The notifications themselves carry no message content.</p>\n  <h3>Downloads, updates and this website</h3>\n  <p>EYES and this website are hosted on GitHub Pages. Like any web server, GitHub keeps ordinary request logs (such as IP address and time). This website uses no cookies, no analytics and no local storage.</p>\n\n  <h2>Permissions</h2>\n  <p>All optional. EYES keeps working if you say no.</p>\n  <ul>\n    <li><b>Camera</b> \u2014 Vision only, while it's open.</li>\n    <li><b>Notification access</b> (Android) \u2014 to show notification glints and music controls in the Eye.</li>\n    <li><b>Screen and audio capture</b> (Android) \u2014 only if you turn on Live Audio; the sound is analysed on the phone and isn't sent anywhere.</li>\n    <li><b>Default Home app</b> (Android) \u2014 only if you choose EYES as your launcher.</li>\n    <li><b>Location</b> (iPhone) \u2014 only if you ask Weather to use where you are.</li>\n    <li><b>Notifications</b> (iPhone) \u2014 only if you turn them on.</li>\n  </ul>\n\n  <h2>Eye Passport</h2>\n  <p>An Eye Passport is a backup you create yourself. It's encrypted on your phone with a passphrase you choose (PBKDF2 and AES-256-GCM), and it never leaves your phone unless you copy it somewhere. Nobody can open it without the passphrase, including FRAY. It contains your friendships' secrets, so keep it to yourself.</p>\n\n  <h2>Questions</h2>\n  <p data-support-line>Write to <a data-support-link href=\"#\">the EYES team</a>.</p>\n</main>\n<footer class=\"foot\"><div class=\"wrap foot-grid\"><p class=\"fine\">EYES by FRAY, INC.</p><nav aria-label=\"Footer\"><a href=\"./\">Home</a><a href=\"attribution.html\">Credits &amp; licences</a></nav></div></footer>\n</body>\n</html>\n"},{"path":"get/apple-touch-icon.png","sha":"d7cce91284b0886ff8cfe743aa1b4130adf9dd93","base64":""},{"path":"get/favicon-32.png","sha":"2aeddb650a842fcf0a30a9f37fd08af7acc7480a","base64":""},{"path":"get/config.js","sha":"9e56052bbd946736b423ef25207cfd69a55731b1","content":"/* EYES website settings \u2014 the only file Patch needs to edit before publishing.\n   Nothing here is secret. The page reads it once; it writes nothing to the browser\n   (no cookies, no localStorage), so it can't touch the EYES iPhone app's data. */\nwindow.EYES_SITE = {\n  // Android download. Paste the URL of the verified, signed APK here.\n  // Keep the SAME URL the current /get/ page uses, so existing links and bookmarks keep working.\n  // While this is empty, the Android buttons jump to the install section and say the download is being prepared.\n  apkUrl: './EYES_4.9.0_build126_SIGNED.apk',\n  apkVersion: '5.0.0 (build 129)',\n  apkSha256: 'b40020c359cbb3114209eb4b6f6a52bbd151e7a96724b6196f0b37302a8e7123',            // optional: shown under the download button when filled in\n\n  // The EYES iPhone app (the repository root, NOT this /get/ page).\n  iphoneUrl: 'https://lilrichie96-hub.github.io/EYES_iPhone/',\n  iphoneVersion: '3.0.0',\n\n  // Problem reports. Leave empty to hide the line.\n  supportEmail: 'lilrichie96@gmail.com',\n\n  // Features that can be hidden before launch without editing the page.\n  //   'show'    \u2192 shown normally\n  //   'testing' \u2192 shown with a \"Testing\" badge and a short caution\n  //   'hide'    \u2192 removed from the page (nav links, sections, FAQ answers)\n  features: {\n    exchange: 'show'        // Eye Exchange: 'show' (default, per Richie: include every feature), 'testing' adds a badge + caution, 'hide' removes it\n  }\n};\n"}]