[{"path":"get/assets/fonts/InterDisplay-Regular.woff","sha":"cf106b057c810592b741fb9823a6de65e739d5b5","base64":""},{"path":"get/assets/fonts/InterDisplay-Medium.woff","sha":"769d832002f59cbdbb6efd5a460341c1bd428485","base64":""},{"path":"get/assets/fonts/OFL.txt","sha":"4f677d3f70978eb0e442c25289051f7408ff42a1","content":"Inter / Inter Display \u2014 Copyright 2016-2023 The Inter Project Authors (https://github.com/rsms/inter)\nSubset to Latin by the EYES website kit. Licensed under the SIL Open Font License 1.1:\n\nLicense: OFL-1.1\nPREAMBLE\nThe goals of the Open Font License (OFL) are to stimulate worldwide\ndevelopment of collaborative font projects, to support the font\ncreation efforts of academic and linguistic communities, and to\nprovide a free and open framework in which fonts may be shared and\nimproved in partnership with others.\n\nThe OFL allows the licensed fonts to be used, studied, modified and\nredistributed freely as long as they are not sold by themselves. The\nfonts, including any derivative works, can be bundled, embedded,\nredistributed and/or sold with any software provided that any\nreserved names are not used by derivative works. The fonts and\nderivatives, however, cannot be released under any other type of\nlicense. The requirement for fonts to remain under this license\ndoes not apply to any document created using the fonts or their\nderivatives.\n\nDEFINITIONS\nFont Software refers to the set of files released by the\nCopyright Holder(s) under this license and clearly marked as such.\nThis may include source files, build scripts and documentation.\n\nReserved Font Name refers to any names specified as such after\nthe copyright statement(s).\n\nOriginal Version refers to the collection of Font Software\ncomponents as distributed by the Copyright Holder(s).\n\nModified Version refers to any derivative made by adding to,\ndeleting, or substituting in part or in whole any of the components\nof the Original Version, by changing formats or by porting the Font\nSoftware to a new environment.\n\nAuthor refers to any designer, engineer, programmer, technical\nwriter or other person who contributed to the Font Software.\n\nPERMISSION & CONDITIONS\nPermission is hereby granted, free of charge, to any person\nobtaining a copy of the Font Software, to use, study, copy, merge,\nembed, modify, redistribute, and sell modified and unmodified copies\nof the Font Software, subject to the following conditions:\n\n1) Neither the Font Software nor any of its individual components,\n   in Original or Modified Versions, may be sold by itself.\n\n2) Original or Modified Versions of the Font Software may be bundled,\n   redistributed and/or sold with any software, provided that each\n   copy contains the above copyright notice and this license. These\n   can be included either as stand-alone text files, human-readable\n   headers or in the appropriate machine-readable metadata fields\n   within text or binary files as long as those fields can be easily\n   viewed by the user.\n\n3) No Modified Version of the Font Software may use the Reserved Font\n   Name(s) unless explicit written permission is granted by the\n   corresponding Copyright Holder. This restriction only applies to\n   the primary font name as presented to the users.\n\n4) The name(s) of the Copyright Holder(s) or the Author(s) of the\n   Font Software shall not be used to promote, endorse or advertise\n   any Modified Version, except to acknowledge the contribution(s)\n   of the Copyright Holder(s) and the Author(s) or with their\n   explicit written permission.\n\n5) The Font Software, modified or unmodified, in part or in whole,\n   must be distributed entirely under this license, and must not be\n   distributed under any other license. The requirement for fonts to\n   remain under this license does not apply to any document created\n   using the Font Software.\n\nTERMINATION\nThis license becomes null and void if any of the above conditions\nare not met.\n\nDISCLAIMER\nTHE FONT SOFTWARE IS PROVIDED AS IS, WITHOUT WARRANTY OF ANY KIND,\nEXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO ANY WARRANTIES OF\nMERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT\nOF COPYRIGHT, PATENT, TRADEMARK, OR OTHER RIGHT. IN NO EVENT SHALL\nTHE COPYRIGHT HOLDER BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, INCLUDING ANY GENERAL, SPECIAL, INDIRECT, INCIDENTAL, OR\nCONSEQUENTIAL DAMAGES, WHETHER IN AN ACTION OF CONTRACT, TORT OR\nOTHERWISE, ARISING FROM, OUT OF THE USE OR INABILITY TO USE THE FONT\nSOFTWARE OR FROM OTHER DEALINGS IN THE FONT SOFTWARE.\n\n"},{"path":"get/assets/fonts/InterDisplay-Light.woff","sha":"e24b6faa1a5a9d484f2458a7e950cf72dd181a7c","base64":""},{"path":"get/assets/css/site.css","sha":"4aabbd2ee091e2e49125fc612bd9102299d8c588","content":"/* EYES 5.0 website \u00b7 Weird. Understated. Alive. */\n@font-face { font-family: \"EYES Display\"; src: url(../fonts/InterDisplay-Light.woff) format(\"woff\"); font-weight: 300; font-display: swap; }\n@font-face { font-family: \"EYES Display\"; src: url(../fonts/InterDisplay-Regular.woff) format(\"woff\"); font-weight: 400; font-display: swap; }\n@font-face { font-family: \"EYES Display\"; src: url(../fonts/InterDisplay-Medium.woff) format(\"woff\"); font-weight: 500; font-display: swap; }\n\n:root {\n  --bg: #050608; --bg2: #0a0c10; --ink: #eceef2; --ink2: #a9aeb8; --ink3: #6f7580;\n  --line: rgba(255, 255, 255, .08); --glass: rgba(255, 255, 255, .035);\n  --rose: #e48aa8; --violet: #a993ff; --sky: #7fb8ff; --mint: #7fe0c0; --amber: #f3b46b;\n  --accent: var(--rose);\n  --r: 22px; --wrap: 1180px;\n  --font: \"EYES Display\", \"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n  color-scheme: dark;\n}\n*, *::before, *::after { box-sizing: border-box; }\nhtml { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }\nbody { margin: 0; background: var(--bg); color: var(--ink); font: 400 17px/1.6 var(--font); -webkit-font-smoothing: antialiased; overflow-x: hidden; }\nimg, video { display: block; max-width: 100%; height: auto; }\na { color: inherit; }\nh1, h2, h3 { font-weight: 300; letter-spacing: -.02em; line-height: 1.08; margin: 0; }\nh2 { font-size: clamp(36px, 5.2vw, 68px); }\nh3 { font-size: 22px; font-weight: 400; letter-spacing: -.01em; }\np { margin: 0 0 1em; }\n.wrap { width: min(var(--wrap), 100% - 40px); margin-inline: auto; }\n.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }\n.skip { position: absolute; left: -999px; top: 8px; z-index: 100; background: var(--ink); color: var(--bg); padding: 10px 16px; border-radius: 10px; }\n.skip:focus { left: 12px; }\n:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 8px; }\n.eyebrow { text-transform: uppercase; letter-spacing: .28em; font-size: 12px; font-weight: 500; color: var(--accent); margin-bottom: 18px; }\n.section-lede { max-width: 640px; color: var(--ink2); font-size: clamp(17px, 1.6vw, 20px); margin-top: 22px; }\n.fine { font-size: 13px; color: var(--ink3); }\nsection { position: relative; padding: clamp(90px, 12vw, 160px) 0; }\n\n/* ---------------------------------------------------------------- nav */\n.nav { position: fixed; inset: 0 0 auto; z-index: 50; display: flex; align-items: center; gap: 20px; padding: 14px max(20px, env(safe-area-inset-left)); background: linear-gradient(#050608f0, #05060800); }\n.nav-brand { display: flex; padding: 8px 4px; }\n.wordmark { width: 74px; height: auto; fill: none; stroke: var(--ink); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; overflow: visible; }\n.wordmark .pupil { fill: var(--ink); stroke: none; }\n.nav nav { margin-left: auto; display: flex; gap: 6px; align-items: center; }\n.nav nav a { text-decoration: none; font-size: 14px; color: var(--ink2); padding: 8px 12px; border-radius: 999px; transition: color .2s, background .2s; }\n.nav nav a:hover { color: var(--ink); background: var(--glass); }\n.nav nav a.nav-cta { color: var(--bg); background: var(--ink); font-weight: 500; }\n.nav-toggle { display: none; margin-left: auto; width: 44px; height: 44px; border: 0; background: none; color: var(--ink); border-radius: 12px; }\n.nav-toggle span[aria-hidden] { display: block; width: 20px; height: 1.5px; margin: auto; background: currentColor; box-shadow: 0 -6px 0 currentColor, 0 6px 0 currentColor; }\n@media (max-width: 900px) {\n  .nav-toggle { display: block; }\n  .nav nav { position: fixed; inset: 64px 12px auto; flex-direction: column; align-items: stretch; padding: 12px; background: #0b0d12; border: 1px solid var(--line); border-radius: 20px; box-shadow: 0 30px 80px rgba(0, 0, 0, .7); display: none; }\n  .nav.open nav { display: flex; }\n  .nav nav a { padding: 14px 16px; font-size: 17px; }\n}\n\n/* ---------------------------------------------------------------- buttons */\n.btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 52px; padding: 0 26px; border-radius: 999px; font: 500 16px var(--font); text-decoration: none; border: 1px solid transparent; cursor: pointer; transition: transform .2s, background .2s, border-color .2s, box-shadow .3s; }\n.btn:hover { transform: translateY(-1px); }\n.btn-primary { background: var(--ink); color: var(--bg); box-shadow: 0 0 0 0 rgba(228, 138, 168, 0); }\n.btn-primary:hover { box-shadow: 0 10px 40px -10px rgba(228, 138, 168, .5); }\n.btn-ghost { background: var(--glass); color: var(--ink); border-color: rgba(255, 255, 255, .16); }\n.btn-ghost:hover { border-color: rgba(255, 255, 255, .32); }\n.btn-play { background: none; color: var(--ink); border: 0; padding: 0; min-height: 64px; font-size: 18px; }\n.btn-play small { color: var(--ink3); font-size: 13px; }\n.play-glyph { position: relative; width: 58px; height: 58px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, .3); background: radial-gradient(circle at 50% 50%, rgba(228, 138, 168, .25), transparent 70%); }\n.play-glyph::after { content: \"\"; position: absolute; left: 23px; top: 19px; border-left: 15px solid var(--ink); border-top: 10px solid transparent; border-bottom: 10px solid transparent; }\n.btn-play:hover .play-glyph { border-color: var(--rose); box-shadow: 0 0 30px rgba(228, 138, 168, .35); }\n.btn-wide { width: 100%; margin-top: 8px; }\n.btn[aria-disabled=\"true\"] { opacity: .55; }\n\n/* ---------------------------------------------------------------- hero */\n.hero { min-height: 100svh; display: grid; align-items: center; padding: 120px 0 80px; overflow: hidden; isolation: isolate; }\n.hero-media { position: absolute; inset: 0; z-index: -1; }\n.hero-video { position: absolute; right: -6vw; top: 50%; translate: 0 -50%; width: min(82vh, 70vw); aspect-ratio: 1; object-fit: cover; mask-image: radial-gradient(circle at 50% 50%, #000 42%, transparent 70%); -webkit-mask-image: radial-gradient(circle at 50% 50%, #000 42%, transparent 70%); opacity: .95; }\n.hero::before { content: \"\"; position: absolute; inset: 0; z-index: -1; background: radial-gradient(60vw 60vh at 75% 50%, rgba(228, 138, 168, .12), transparent 70%), radial-gradient(50vw 50vh at 10% 90%, rgba(127, 184, 255, .05), transparent 70%); }\n.hero-copy { width: min(var(--wrap), 100% - 40px); margin-inline: auto; position: relative; }\n.hero h1 { font-size: clamp(48px, 7.4vw, 104px); letter-spacing: -.035em; line-height: .98; margin-bottom: 28px; }\n.hero h1 span { background: linear-gradient(90deg, #fff, var(--rose) 60%, var(--violet)); -webkit-background-clip: text; background-clip: text; color: transparent; }\n.lede { max-width: 470px; color: var(--ink2); font-size: clamp(17px, 1.6vw, 20px); }\n.hero-actions { margin: 34px 0 22px; }\n.hero-get { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 16px; }\n@media (max-width: 760px) {\n  .hero { align-items: end; padding-top: 70px; }\n  .hero-video { right: 50%; translate: 50% 0; top: 56px; width: 100vw; opacity: .9; }\n  .hero-copy { padding-top: 84vw; }\n  .hero-get .btn { flex: 1 1 100%; }\n}\n\n/* ---------------------------------------------------------------- meet */\n.meet { --accent: var(--rose); }\n.eye-gallery { list-style: none; margin: 60px 0; padding: 10px 20px 30px; display: grid; grid-auto-flow: column; grid-auto-columns: clamp(170px, 20vw, 240px); gap: 10px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; justify-content: safe center; }\n.eye-gallery::-webkit-scrollbar { display: none; }\n.eye-gallery li { scroll-snap-align: center; text-align: center; }\n.eye-gallery img { width: 100%; aspect-ratio: 1; object-fit: contain; transition: transform .6s cubic-bezier(.2, .8, .2, 1), filter .6s; filter: saturate(.92); }\n.eye-gallery li:hover img { transform: scale(1.06) translateY(-4px); filter: saturate(1.1); }\n.eye-gallery b { display: block; font-weight: 300; font-size: 24px; margin-top: 4px; }\n.eye-gallery span { font-size: 11px; letter-spacing: .26em; text-transform: uppercase; color: var(--ink3); }\n.meet-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 40px 32px; margin-top: 10px; }\n.meet-grid p { color: var(--ink2); margin-top: 10px; }\n.promise { margin-top: 70px; padding: 28px 32px; border: 1px solid var(--line); border-radius: var(--r); background: linear-gradient(120deg, rgba(228, 138, 168, .07), rgba(169, 147, 255, .04)); }\n.promise p { margin: 0; color: var(--ink2); font-size: 18px; }\n.promise b { color: var(--ink); font-weight: 500; display: block; font-size: 22px; margin-bottom: 6px; }\n\n/* ---------------------------------------------------------------- abilities */\n.abilities { --accent: var(--sky); background: linear-gradient(var(--bg), #070a10 30%, var(--bg)); }\n.ability-list { display: grid; gap: clamp(60px, 9vw, 120px); margin-top: 80px; }\n.ability { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(30px, 6vw, 90px); align-items: center; }\n.ability:nth-child(even) .ability-media { order: 2; }\n.ability-media { position: relative; justify-self: center; width: min(330px, 100%); aspect-ratio: 824 / 1830; border-radius: 40px; overflow: hidden; border: 1px solid rgba(255, 255, 255, .1); box-shadow: 0 40px 120px -40px var(--tone, rgba(127, 184, 255, .45)), inset 0 0 0 6px #0c0e12; background: #0b0e13; }\n.ability-media video { width: 100%; height: 100%; object-fit: cover; }\n.ability h3 { font-size: clamp(30px, 3.4vw, 44px); font-weight: 300; margin-bottom: 18px; }\n.ability .num { display: block; font-size: 12px; letter-spacing: .3em; color: var(--tone-ink, var(--sky)); margin-bottom: 14px; font-weight: 500; }\n.ability-copy p { color: var(--ink2); font-size: 18px; max-width: 460px; }\n.ability-copy .tag { font-size: 13px; letter-spacing: .04em; color: var(--ink3); border-top: 1px solid var(--line); padding-top: 14px; }\n.ability-copy .tag a { color: var(--tone-ink, var(--sky)); text-decoration: none; }\n.ability[data-tone=\"vision\"] { --tone: rgba(228, 138, 168, .5); --tone-ink: var(--rose); }\n.ability[data-tone=\"weather\"] { --tone: rgba(127, 184, 255, .5); --tone-ink: var(--sky); }\n.ability[data-tone=\"pocket\"] { --tone: rgba(228, 120, 170, .45); --tone-ink: #f29bc4; }\n.ability[data-tone=\"arcade\"] { --tone: rgba(200, 200, 230, .35); --tone-ink: #c9c9ee; }\n.ability[data-tone=\"contact\"] { --tone: rgba(169, 147, 255, .5); --tone-ink: var(--violet); }\n.ability[data-tone=\"play\"] { --tone: rgba(214, 220, 110, .4); --tone-ink: #dfe27f; }\n@media (max-width: 760px) {\n  .ability { grid-template-columns: 1fr; }\n  .ability:nth-child(even) .ability-media { order: 0; }\n  .ability-media { width: min(280px, 76vw); }\n}\n\n/* ---------------------------------------------------------------- arcade */\n.arcade { --accent: var(--amber); overflow: hidden; }\n.arcade::before { content: \"\"; position: absolute; inset: 10% -10% auto; height: 70%; background: radial-gradient(closest-side, rgba(243, 180, 107, .08), transparent); pointer-events: none; }\n.carts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; margin-top: 70px; }\n.cart { background: linear-gradient(180deg, #101218, #0a0b0f); border: 1px solid var(--line); border-radius: 26px; padding: 14px 14px 22px; transition: transform .4s cubic-bezier(.2, .8, .2, 1), border-color .4s; }\n.cart:hover { transform: translateY(-6px); border-color: rgba(243, 180, 107, .35); }\n.cart-screen { aspect-ratio: 1; border-radius: 18px; overflow: hidden; background: #000; margin-bottom: 18px; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .06); }\n.cart-screen video { width: 100%; height: 100%; object-fit: cover; image-rendering: pixelated; }\n.cart h3 { padding: 0 8px; font-size: 22px; }\n.cart p { padding: 0 8px; color: var(--ink2); font-size: 15px; margin: 8px 0 0; }\n@media (max-width: 980px) { .carts { grid-template-columns: repeat(2, 1fr); } }\n@media (max-width: 520px) { .carts { grid-template-columns: 1fr; } }\n\n/* ---------------------------------------------------------------- contact */\n.contact { --accent: var(--violet); background: radial-gradient(70vw 50vh at 50% 30%, rgba(169, 147, 255, .07), transparent 70%); }\n.contact-grid { display: grid; grid-template-columns: minmax(240px, 380px) 1fr; gap: clamp(30px, 6vw, 90px); align-items: center; margin-top: 70px; }\n.contact-hero img, .phone-shot img, .passport-shot img { border-radius: 36px; border: 1px solid rgba(255, 255, 255, .1); box-shadow: 0 40px 120px -40px rgba(169, 147, 255, .45), inset 0 0 0 6px #0c0e12; }\n.contact-points { display: grid; grid-template-columns: 1fr 1fr; gap: 34px 30px; }\n.contact-points p { color: var(--ink2); margin-top: 10px; }\n.contact-strip, .home-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-top: 70px; }\n.contact-strip figure, .home-strip figure { margin: 0; }\n.contact-strip img, .home-strip img { border-radius: 24px; border: 1px solid var(--line); }\nfigcaption { text-align: center; margin-top: 12px; font-size: 12px; letter-spacing: .24em; text-transform: uppercase; color: var(--ink3); }\n.badge { display: inline-block; vertical-align: middle; font-size: 10px; letter-spacing: .16em; text-transform: uppercase; padding: 3px 8px; border-radius: 999px; border: 1px solid rgba(243, 180, 107, .5); color: var(--amber); margin-left: 6px; }\n.exchange-note { margin-top: 60px; padding: 28px 32px; border: 1px solid var(--line); background: linear-gradient(120deg, rgba(169, 147, 255, .07), rgba(228, 138, 168, .04)); border-radius: var(--r); }\n.exchange-note h3 { margin-bottom: 12px; }\n.exchange-note p { color: var(--ink2); max-width: 760px; }\nhtml[data-exchange=\"hide\"] [data-feature=\"exchange\"] { display: none !important; }\nhtml:not([data-exchange=\"testing\"]) [data-testing-badge], html:not([data-exchange=\"testing\"]) [data-testing-only] { display: none; }\n@media (max-width: 860px) {\n  .contact-grid { grid-template-columns: 1fr; }\n  .contact-hero { width: min(300px, 80vw); margin: 0 auto; }\n  .contact-points { grid-template-columns: 1fr; }\n  .contact-strip, .home-strip { grid-template-columns: repeat(2, 1fr); }\n}\n\n/* ---------------------------------------------------------------- android home */\n.homescreen { --accent: var(--mint); }\n.home-grid { display: grid; grid-template-columns: minmax(240px, 360px) 1fr; gap: clamp(30px, 6vw, 90px); align-items: center; margin-top: 70px; }\n.phone-shot img { box-shadow: 0 40px 120px -40px rgba(127, 224, 192, .35), inset 0 0 0 6px #0c0e12; }\n.feature-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 26px 30px; }\n.feature-list b { display: block; font-weight: 400; font-size: 19px; }\n.feature-list span { color: var(--ink2); font-size: 15px; }\n.compare { margin-top: 80px; overflow-x: auto; border: 1px solid var(--line); border-radius: var(--r); }\n.compare table { width: 100%; border-collapse: collapse; min-width: 560px; }\n.compare caption { text-align: left; padding: 22px 24px 8px; font-size: 22px; font-weight: 300; }\n.compare th, .compare td { padding: 14px 24px; border-top: 1px solid var(--line); text-align: left; font-weight: 400; }\n.compare thead th { color: var(--ink3); font-size: 12px; letter-spacing: .22em; text-transform: uppercase; border-top: 0; }\n.compare tbody th { color: var(--ink2); }\n.compare td { width: 22%; color: var(--ink); }\n@media (max-width: 860px) {\n  .home-grid { grid-template-columns: 1fr; }\n  .phone-shot { width: min(300px, 80vw); margin: 0 auto; }\n  .feature-list { grid-template-columns: 1fr; }\n}\n\n/* ---------------------------------------------------------------- install */\n.install { --accent: var(--rose); background: linear-gradient(var(--bg), #0a0710 50%, var(--bg)); }\n.install-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 60px; }\n.install-card { padding: clamp(24px, 4vw, 40px); border: 1px solid var(--line); border-radius: 28px; background: linear-gradient(180deg, rgba(255, 255, 255, .035), rgba(255, 255, 255, .01)); scroll-margin-top: 90px; }\n.install-card h3 { font-size: 34px; font-weight: 300; margin-bottom: 26px; }\n.steps { list-style: none; counter-reset: s; padding: 0; margin: 0 0 26px; display: grid; gap: 18px; }\n.steps li { counter-increment: s; position: relative; padding-left: 52px; }\n.steps li::before { content: counter(s); position: absolute; left: 0; top: -2px; width: 34px; height: 34px; display: grid; place-items: center; border-radius: 50%; border: 1px solid rgba(255, 255, 255, .2); font-size: 14px; color: var(--accent); }\n.steps b { display: block; font-weight: 500; }\n.steps span { color: var(--ink2); font-size: 15px; }\n.callout { margin: 22px 0 0; padding: 16px 18px; border-radius: 16px; background: rgba(243, 180, 107, .07); border: 1px solid rgba(243, 180, 107, .2); font-size: 15px; color: var(--ink2); }\n.callout b { color: var(--ink); font-weight: 500; }\n@media (max-width: 860px) { .install-grid { grid-template-columns: 1fr; } }\n\n/* ---------------------------------------------------------------- faq */\n.faq { --accent: var(--sky); }\n.faq-top { display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: end; }\n.passport-shot { width: 200px; margin: 0; }\n.faq-list { margin-top: 50px; border-top: 1px solid var(--line); }\ndetails { border-bottom: 1px solid var(--line); }\nsummary { cursor: pointer; list-style: none; padding: 24px 50px 24px 0; font-size: clamp(18px, 2vw, 22px); font-weight: 300; position: relative; }\nsummary::-webkit-details-marker { display: none; }\nsummary::after { content: \"\"; position: absolute; right: 8px; top: 50%; width: 12px; height: 12px; border-right: 1.5px solid var(--ink2); border-bottom: 1.5px solid var(--ink2); translate: 0 -70%; rotate: 45deg; transition: rotate .3s; }\ndetails[open] summary::after { rotate: 225deg; translate: 0 -20%; }\ndetails p, details ul { color: var(--ink2); max-width: 780px; }\ndetails ul { padding-left: 20px; margin: 0 0 1.4em; }\ndetails li { margin-bottom: 8px; }\ndetails b { color: var(--ink); font-weight: 500; }\n@media (max-width: 640px) { .faq-top { grid-template-columns: 1fr; } .passport-shot { width: 160px; } }\n\n/* ---------------------------------------------------------------- footer */\n.foot { padding: 70px 0 calc(40px + env(safe-area-inset-bottom)); border-top: 1px solid var(--line); }\n.foot-grid { display: flex; justify-content: space-between; align-items: flex-start; gap: 30px; flex-wrap: wrap; }\n.foot nav { display: flex; gap: 22px; flex-wrap: wrap; }\n.foot nav a { color: var(--ink2); text-decoration: none; font-size: 15px; }\n.foot nav a:hover { color: var(--ink); }\n.foot .wordmark { margin-bottom: 14px; }\n.media-note { margin-top: 30px; }\n\n/* ---------------------------------------------------------------- trailer dialog */\n.trailer { width: min(1200px, 96vw); max-width: none; max-height: 100svh; padding: 60px 0 0; border: 0; background: transparent; color: var(--ink); overflow: visible; }\n.trailer::backdrop { background: rgba(2, 3, 4, .92); backdrop-filter: blur(6px); }\n.trailer-inner { position: relative; }\n.trailer video { width: 100%; aspect-ratio: 16 / 9; background: #000; border-radius: 18px; }\n.trailer-close { position: absolute; top: -56px; right: 4px; width: 44px; height: 44px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, .25); background: rgba(0, 0, 0, .4); color: var(--ink); font-size: 26px; line-height: 1; cursor: pointer; }\n\n/* ---------------------------------------------------------------- reveal (only when JS + motion allowed) */\n.js .reveal { opacity: 0; translate: 0 24px; transition: opacity .9s ease, translate .9s cubic-bezier(.2, .8, .2, 1); }\n.js .reveal.in { opacity: 1; translate: 0 0; }\n\n@media (prefers-reduced-motion: reduce) {\n  html { scroll-behavior: auto; }\n  *, *::before, *::after { transition-duration: .01ms !important; animation-duration: .01ms !important; }\n  .js .reveal { opacity: 1; translate: none; }\n}\n"},{"path":"get/assets/css/page.css","sha":"8e811bed68b23001e0d971e477733c81976e87b5","content":"/* simple text pages (privacy, credits) */\n.page-head { padding: 26px 0; }\n.back { text-decoration: none; color: var(--ink2); font-size: 15px; }\n.back:hover { color: var(--ink); }\n.prose { max-width: 760px; padding-bottom: 90px; }\n.prose h1 { font-size: clamp(36px, 5vw, 56px); margin-bottom: 18px; }\n.prose h2 { font-size: 26px; margin: 46px 0 14px; font-weight: 400; }\n.prose h3 { font-size: 19px; margin: 26px 0 8px; font-weight: 500; }\n.prose p, .prose li { color: var(--ink2); }\n.prose b { color: var(--ink); font-weight: 500; }\n.prose ul { padding-left: 20px; }\n.prose li { margin-bottom: 8px; }\n.prose a { color: var(--ink); text-underline-offset: 3px; }\n"},{"path":"get/assets/js/page.js","sha":"e4d5853d2d2e3d448afb14e048870e065e00e304","content":"/* text pages: apply config.js (feature flags, support address). No storage, no tracking. */\n(() => {\n  'use strict';\n  const cfg = window.EYES_SITE || {}, doc = document.documentElement;\n  const ex = (cfg.features && cfg.features.exchange) || 'show';\n  doc.dataset.exchange = ['show', 'testing', 'hide'].includes(ex) ? ex : 'show';\n  if (doc.dataset.exchange === 'hide') document.querySelectorAll('[data-feature=\"exchange\"]').forEach((el) => el.remove());\n  const link = document.querySelector('[data-support-link]'), line = document.querySelector('[data-support-line]');\n  if (link && cfg.supportEmail) link.href = 'mailto:' + cfg.supportEmail;\n  else if (line) line.remove();\n})();\n"},{"path":"get/assets/js/site.js","sha":"13b0d5d5826b5a0b14b0d226524e057b1a1c874f","content":"/* EYES website behaviour. No tracking, no cookies, no storage, no service worker. */\n(() => {\n  'use strict';\n  const cfg = Object.assign({ apkUrl: '', iphoneUrl: 'https://lilrichie96-hub.github.io/EYES_iPhone/', features: {} }, window.EYES_SITE || {});\n  const doc = document.documentElement;\n  const reduced = matchMedia('(prefers-reduced-motion: reduce)');\n  doc.classList.add('js');\n\n  // ---- feature flags (Eye Exchange can be marked testing or hidden from config.js)\n  const ex = (cfg.features && cfg.features.exchange) || 'show';\n  doc.dataset.exchange = ['show', 'testing', 'hide'].includes(ex) ? ex : 'show';\n  if (doc.dataset.exchange === 'hide') document.querySelectorAll('[data-feature=\"exchange\"]').forEach((el) => el.remove());\n\n  // ---- download links\n  const apk = String(cfg.apkUrl || '').trim();\n  document.querySelectorAll('[data-apk]').forEach((a) => {\n    if (apk) { a.href = apk; a.setAttribute('download', ''); a.removeAttribute('aria-disabled'); }\n    else { a.href = '#install-android'; a.setAttribute('aria-disabled', 'true'); a.title = 'The Android download is being prepared'; }\n  });\n  const meta = document.querySelector('[data-apk-meta]');\n  if (meta) {\n    meta.textContent = apk\n      ? `EYES ${cfg.apkVersion || ''} for Android 8 or newer${cfg.apkSha256 ? ' \u00b7 SHA-256 ' + cfg.apkSha256 : ''}`\n      : 'The Android download is being prepared. Check back soon.';\n  }\n  document.querySelectorAll('[data-iphone]').forEach((a) => { if (cfg.iphoneUrl) { a.href = cfg.iphoneUrl; a.rel = 'noopener'; } });\n  const support = document.querySelector('[data-support]');\n  if (support && cfg.supportEmail) { support.href = 'mailto:' + cfg.supportEmail + '?subject=' + encodeURIComponent('EYES problem report'); support.hidden = false; }\n\n  // ---- mobile nav\n  const nav = document.querySelector('.nav'), toggle = document.querySelector('.nav-toggle');\n  if (toggle) {\n    toggle.addEventListener('click', () => { const open = !nav.classList.contains('open'); nav.classList.toggle('open', open); toggle.setAttribute('aria-expanded', String(open)); });\n    nav.querySelectorAll('nav a').forEach((a) => a.addEventListener('click', () => { nav.classList.remove('open'); toggle.setAttribute('aria-expanded', 'false'); }));\n    addEventListener('keydown', (e) => { if (e.key === 'Escape' && nav.classList.contains('open')) { nav.classList.remove('open'); toggle.setAttribute('aria-expanded', 'false'); toggle.focus(); } });\n  }\n\n  // ---- silent preview videos: load and play only while visible, never with reduced motion or Save-Data\n  const saveData = navigator.connection && navigator.connection.saveData;\n  const vids = [...document.querySelectorAll('video[data-autoplay]')];\n  const playable = () => !reduced.matches && !saveData;\n  const io = 'IntersectionObserver' in window ? new IntersectionObserver((entries) => {\n    for (const e of entries) {\n      const v = e.target;\n      if (e.isIntersecting && playable()) {\n        if (v.preload === 'none') v.preload = 'auto';\n        v.muted = true; const p = v.play(); if (p && p.catch) p.catch(() => {});\n      } else if (!v.paused) v.pause();\n    }\n  }, { rootMargin: '200px 0px', threshold: 0.15 }) : null;\n  vids.forEach((v) => { v.muted = true; if (io) io.observe(v); });\n  reduced.addEventListener && reduced.addEventListener('change', () => { if (reduced.matches) vids.forEach((v) => v.pause()); });\n\n  // ---- reveal on scroll (purely decorative; skipped with reduced motion)\n  if (!reduced.matches && 'IntersectionObserver' in window) {\n    const targets = document.querySelectorAll('section .wrap > h2, .section-lede, .ability, .cart, .meet-grid article, .contact-points article, .install-card, .eye-gallery li, .promise');\n    const ro = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); ro.unobserve(e.target); } }), { threshold: 0.12 });\n    targets.forEach((el) => { el.classList.add('reveal'); ro.observe(el); });\n  }\n\n  // ---- trailer: loads only when asked, plays WITH sound because the visitor asked for it\n  const dlg = document.getElementById('trailer'), tv = document.getElementById('trailerVideo');\n  const SOURCES = [['media/trailer/eyes-trailer-web.mp4', 'video/mp4']];\n  let opener = null;\n  function openTrailer(e) {\n    opener = e && e.currentTarget;\n    if (!tv.querySelector('source')) { for (const [src, type] of SOURCES) { const s = document.createElement('source'); s.src = src; s.type = type; tv.prepend(s); } tv.load(); }\n    if (dlg.showModal) dlg.showModal(); else dlg.setAttribute('open', '');\n    tv.muted = false; tv.volume = 1;\n    const p = tv.play(); if (p && p.catch) p.catch(() => {});\n    tv.focus();\n  }\n  function closeTrailer() { tv.pause(); if (dlg.close) dlg.close(); else dlg.removeAttribute('open'); if (opener) opener.focus(); }\n  document.querySelectorAll('[data-trailer]').forEach((b) => b.addEventListener('click', openTrailer));\n  dlg.querySelector('[data-close]').addEventListener('click', closeTrailer);\n  dlg.addEventListener('close', () => tv.pause());\n  dlg.addEventListener('click', (e) => { if (e.target === dlg) closeTrailer(); });\n})();\n"},{"path":"get/favicon.svg","sha":"74cce6d90b619f36cfb902fa4d28196bec1ca375","content":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\">\n<defs><radialGradient id=\"g\" cx=\"50%\" cy=\"50%\" r=\"50%\"><stop offset=\"0\" stop-color=\"#fff\"/><stop offset=\".18\" stop-color=\"#ffd3e2\"/><stop offset=\".5\" stop-color=\"#c25a85\"/><stop offset=\"1\" stop-color=\"#3a1426\"/></radialGradient>\n<radialGradient id=\"s\" cx=\"50%\" cy=\"40%\" r=\"60%\"><stop offset=\"0\" stop-color=\"#2a1420\"/><stop offset=\"1\" stop-color=\"#07080b\"/></radialGradient></defs>\n<rect width=\"64\" height=\"64\" rx=\"15\" fill=\"#07080b\"/>\n<path d=\"M12 27 Q32 13 52 27\" fill=\"none\" stroke=\"#e48aa8\" stroke-width=\"1.6\" stroke-linecap=\"round\" opacity=\".9\"/>\n<circle cx=\"32\" cy=\"35\" r=\"19\" fill=\"url(#s)\" stroke=\"#e48aa8\" stroke-opacity=\".35\"/>\n<circle cx=\"32\" cy=\"35\" r=\"11\" fill=\"url(#g)\"/>\n<g stroke=\"#ffe3ee\" stroke-width=\".7\" stroke-linecap=\"round\" opacity=\".8\"><path d=\"M35.40 35.00 L42.50 35.00\"/><path d=\"M35.19 36.16 L41.87 38.59\"/><path d=\"M34.60 37.19 L40.04 41.75\"/><path d=\"M33.70 37.94 L37.25 44.09\"/><path d=\"M32.59 38.35 L33.82 45.34\"/><path d=\"M31.41 38.35 L30.18 45.34\"/><path d=\"M30.30 37.94 L26.75 44.09\"/><path d=\"M29.40 37.19 L23.96 41.75\"/><path d=\"M28.81 36.16 L22.13 38.59\"/><path d=\"M28.60 35.00 L21.50 35.00\"/><path d=\"M28.81 33.84 L22.13 31.41\"/><path d=\"M29.40 32.81 L23.96 28.25\"/><path d=\"M30.30 32.06 L26.75 25.91\"/><path d=\"M31.41 31.65 L30.18 24.66\"/><path d=\"M32.59 31.65 L33.82 24.66\"/><path d=\"M33.70 32.06 L37.25 25.91\"/><path d=\"M34.60 32.81 L40.04 28.25\"/><path d=\"M35.19 33.84 L41.87 31.41\"/></g>\n<circle cx=\"32\" cy=\"35\" r=\"2.6\" fill=\"#fff\"/>\n<ellipse cx=\"25\" cy=\"25\" rx=\"3.2\" ry=\"1.6\" fill=\"#fff\" opacity=\".35\" transform=\"rotate(-25 25 25)\"/>\n</svg>"},{"path":"get/media/social/og-cover.jpg","sha":"227e68b33163e18f8fd640827ddd40a35954b7c2","base64":""},{"path":"get/media/hero/hero-loop.mp4","sha":"c90393fac54818e3eb4443d380a9cb3a87358429","base64":""},{"path":"get/media/hero/hero-loop.webm","sha":"eda1641da9f390598de6c040c5139c327d0444a2","base64":""},{"path":"get/media/hero/hero-poster.webp","sha":"f2188a7a7e6f4875ce52f2cf269bd12c68060887","base64":""},{"path":"get/media/card/passport.webp","sha":"768e9070a906d9b871de519a543367ce8c3eccfb","base64":""},{"path":"get/media/card/rename.webp","sha":"c5aee0070f3812c3a7a877255c6da236532a744c","base64":""},{"path":"get/media/card/eyed.webp","sha":"288e1058859c5e78bb89b4567d9b9c764eae5913","base64":""},{"path":"get/media/eyes/eye-ikoi.webp","sha":"8f6ad8ae57d48a790f13e96d209aa82f1d31c1ca","base64":""},{"path":"get/media/eyes/eye-junoel.webp","sha":"e4e26294e12a40bda42ad2a0ce4827d55f6add1d","base64":""},{"path":"get/media/eyes/eye-luni.webp","sha":"b86893864f9d61812ab5f686357fc664c53153f7","base64":"